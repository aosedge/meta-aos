[Unit]
Description=AosCore Service Manager
Wants=network-online.target dbus.service aos-iam.service
After=network-online.target dbus.service aos-iam.service
ConditionPathExists=/var/aos/.provisionstate
PartOf=aos.target

[Service]
Type=notify
EnvironmentFile=/etc/default/aoscore.env
ExecStart=/usr/bin/aos_sm_app -c /etc/aos/sm.cfg -v ${AOS_LOG_LEVEL} -j
ExecStop=/bin/sh -c "/bin/kill -s TERM $MAINPID; while [ -d /proc/$MAINPID ]; do sleep 1; done"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
