[Unit]
Description=AosCore Identity and Access Manager
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/aos/.provisionstate
PartOf=aos.target

[Service]
Type=notify
ExecStartPre=-/opt/aos/deprovision.sh
EnvironmentFile=/etc/default/aoscore.env
ExecStart=/usr/bin/aos_iam_app -c /etc/aos/iam.cfg -provisioning -v ${AOS_LOG_LEVEL} -j
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
