[Unit]
Description=AosCore Message Proxy
Wants=network-online.target aos-iam.service
After=network-online.target aos-iam.service
ConditionPathExists=!/var/aos/.provisionstate
PartOf=aos.target

[Service]
Type=notify
EnvironmentFile=/etc/default/aoscore.env
ExecStart=/usr/bin/aos_mp_app -c /etc/aos/mp.cfg -provisioning -v ${AOS_LOG_LEVEL} -j
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
