[Unit]
Description=process-exporter (AosCore benchmarking)
After=network.target

[Service]
Type=simple
# -threads=false: skip per-thread /proc iteration - the dashboard only uses group-level CPU%/PSS
# memory (see aos-benchmark.json), and per-thread accounting is the most expensive part of each
# scrape. -gather-smaps stays enabled (default) since PSS memory needs it. See also scrape.yml's
# metric_relabel_configs, which further narrows what's actually stored to just the series used.
ExecStart=/usr/bin/process-exporter \
    -config.path=/etc/process-exporter/process-exporter.yml \
    -web.listen-address=0.0.0.0:9256 \
    -threads=false
Restart=on-failure

[Install]
WantedBy=multi-user.target
